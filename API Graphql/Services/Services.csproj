<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Data\Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- HotChocolate 14.2.0 — first stable release with native .NET 8 + C# 12 support -->
    <PackageReference Include="HotChocolate.Types" Version="14.2.0" />
    <!-- System.ComponentModel.Annotations is inbox in .NET 8 — no PackageReference needed -->
    <!-- BCrypt.Net-Next — framework-agnostic, no version change needed -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
  </ItemGroup>

</Project>
