erDiagram
    User {
        guid Id PK,FK
    }
    Subject {
        int Id PK
    }
    Career {
        int Id PK
    }
    AcademicResource {
        guid Id PK
        string Category
        datetime CreatedAt
        datetime CreationDate
        string CreationUser
        string Description "NULL"
        bool Disabled
        string ExternalUrl "NULL"
        string FileUrl "NULL"
        bool IsActive
        datetime ModificationDate
        string ModificationUser
        string ResourceType
        int SubjectId FK
        string Title
        datetime UpdatedAt "NULL"
        guid UploaderId FK
        int Version
    }
    AcademicProgress {
        guid Id PK
        guid AssignedById FK
        datetime CreationDate
        string CreationUser
        bool Disabled
        datetime ModificationDate
        string ModificationUser
        string Notes "NULL"
        decimal Score "NULL; decimal(5,2)"
        string Status
        int SubjectId FK
        datetime UpdatedAt
        guid UserId FK "UQ UserId,SubjectId"
    }
    CourseSection {
        guid Id PK
        string Code
        datetime CreatedAtUtc
        int SubjectId FK "UQ SubjectId,Term,Code"
        string Term
    }
    SectionInstructor {
        guid SectionId PK,FK
        guid ProfessorId PK,FK
        datetime AssignedAtUtc
    }
    SectionEnrollment {
        guid SectionId PK,FK
        guid StudentId PK,FK
        datetime EnrolledAtUtc
    }
    SectionGrade {
        guid Id PK
        guid AssignedById FK
        bytes RowVersion "SQL rowversion"
        decimal Score "NULL; decimal(5,2)"
        guid SectionId FK "FK SectionId,StudentId; UQ SectionId,StudentId"
        string Status
        guid StudentId FK "FK SectionId,StudentId"
        datetime UpdatedAtUtc
    }
    EnrollmentStanding {
        guid Id PK
        int CareerId FK
        datetime CreatedAtUtc
        datetime RevokedAtUtc "NULL"
        string Source
        string SourceReference
        string Status
        guid StudentId FK
        string Term
        datetime ValidFromUtc
        datetime ValidUntilUtc
    }
    RegularStudentCertificate {
        guid Id PK
        string CareerName
        string FullName
        datetime IssuedAt
        guid StandingId FK
        string Term
        datetime ValidUntil
    }
    JobOffer {
        guid Id PK
        string Company
        datetime CreatedAt
        datetime CreationDate
        string CreationUser
        string Description
        bool Disabled
        guid EmployerId FK
        bool IsActive
        string Location
        datetime ModificationDate
        string ModificationUser
        string Title
    }
    JobApplication {
        guid Id PK
        guid ApplicantId FK
        datetime AppliedAt
        datetime CreationDate
        string CreationUser
        bool Disabled
        guid JobOfferId FK "UQ JobOfferId,ApplicantId"
        datetime ModificationDate
        string ModificationUser
        string Status
    }
    JobApplicationCv {
        guid ApplicationId PK,FK
        datetime CapturedAtUtc
        string PayloadJson
        int SchemaVersion
    }
    EmployerRequest {
        guid Id PK
        string Comments "NULL"
        string CompanyName
        string ContactName
        datetime CreatedAt
        string Email UK "UQ filtrada"
        int EmailDeliveryAttempts
        string EmailDeliveryStatus
        datetime LastEmailAttemptAt "NULL"
        string Phone
        datetime PrivacyConsentAt
        datetime ProcessedAt "NULL"
        guid ProcessedByAdminId FK "NULL"
        guid ProvisionedUserId FK "NULL"
        string RejectionReason "NULL"
        bytes RowVersion "SQL rowversion"
        string Status
        string TaxId UK "UQ filtrada"
    }
    EmployerOnboardingOutboxMessage {
        guid Id PK
        int Attempts
        datetime CreatedAt
        guid EmployerRequestId FK,UK
        string LastErrorCode "NULL"
        datetime LeaseExpiresAt "NULL"
        datetime NextAttemptAt
        datetime ProcessedAt "NULL"
        bytes RowVersion "SQL rowversion"
        string Status
    }
    AuditLog {
        guid Id PK
        string Action
        guid ActorUserId FK "NULL"
        string CorrelationId "NULL"
        datetime CreatedAt
        string EntityId
        string EntityName
        string NewValuesJson "NULL"
        string OldValuesJson "NULL"
    }

    Subject ||..o{ AcademicResource : "SubjectId"
