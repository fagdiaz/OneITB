        uuid Id PK
        uuid InquiryId FK
        uuid CommentId FK
        string FileUrl
        string FileType
        string OriginalFileName
        bigint FileSizeBytes
        datetime UploadedAt
    }
    REACTION {
        uuid Id PK
        uuid InquiryId FK
        uuid UserId FK
        string Type
        datetime CreatedAt
    }
    COMMENT_REACTION {
        uuid Id PK
        uuid CommentId FK
        uuid UserId FK
        string Type
        datetime CreatedAt
    }
    COMMUNITY_REPORT {
        uuid Id PK
        uuid ReporterId FK
        string TargetType
        uuid TargetId
        string Reason
        string Details
        string Status
        datetime CreatedAt
    }
    USER_INTERACTION {
        uuid Id PK
        uuid UserId FK
        uuid TargetUserId FK
        string Type
        datetime CreatedAt
    }
    MESSAGE {
        uuid Id PK
        uuid SenderId FK
        uuid ReceiverId FK
        string Content
        bool IsRead
        datetime ReadAt
        datetime CreatedAt
    }
    NOTIFICATION {
        uuid Id PK
        uuid UserId FK
        string Title
        string Message
        string Type
        string TargetUrl
        bool IsRead
        datetime CreatedAt
    }
    NOTIFICATION_PREFERENCE {
        uuid Id PK
        uuid UserId FK
        bool EmailJobAlerts
        bool EmailMentions
        bool EmailDigest
        bool InAppSound
    }

