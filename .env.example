ONEITB_SQL_SA_PASSWORD=Change_this_local_password_123!
# Required by docker-compose.prod.yml. Replace every placeholder locally and
# use a SQL endpoint whose certificate chain is trusted by the API container.
ONEITB_DB_CONNECTION_STRING=Server=sql.example.edu,1433;Database=OneItb;User Id=oneitb_app;Password=REPLACE_LOCALLY;Encrypt=True;TrustServerCertificate=False;
ONEITB_JWT_ISSUER=https://oneitb.example.edu/
ONEITB_JWT_AUDIENCE=https://oneitb.example.edu/
ONEITB_JWT_KEY=
ONEITB_MAGIC_LINK_FRONTEND_URL=https://oneitb.example.edu
ONEITB_PASSWORD_HASHING_WORK_FACTOR=12

# Optional Microsoft Entra institutional SSO. Identifiers/scopes are public
# configuration; never place a client secret in Vite or in this file.
ONEITB_ENTRA_ENABLED=false
ONEITB_ENTRA_TENANT_ID=
ONEITB_ENTRA_API_CLIENT_ID=
ONEITB_ENTRA_SPA_CLIENT_ID=
ONEITB_ENTRA_API_SCOPE=
ONEITB_ENTRA_REQUIRED_SCOPE=access_as_user
ONEITB_ENTRA_ALLOWED_DOMAIN=itbeltran.com.ar
ONEITB_ENTRA_REDIRECT_URI=

# Optional production/demo settings. Leave empty locally unless you are testing the service.
ONEITB_SEED_ENABLE_DEMO_DATA=false
ONEITB_SEED_DEMO_PASSWORD=
ONEITB_REDIS_CONNECTION=
ONEITB_CLOUDINARY_URL=

# SMTP is mandatory in Production. Development uses the ignored App_Data/MailDrop pickup when all values are empty.
ONEITB_SMTP_HOST=
ONEITB_SMTP_PORT=587
ONEITB_SMTP_USER=
ONEITB_SMTP_PASS=
ONEITB_SMTP_FROM=
ONEITB_SMTP_ENABLE_SSL=true

# API and operation-specific abuse protection.
ONEITB_RATE_LIMIT_PER_MINUTE=100
ONEITB_RATE_LIMIT_WINDOW_MINUTES=1
ONEITB_PUBLIC_REGISTRATION_DOMAIN=itbeltran.com.ar
ONEITB_REGISTRATION_IP_LIMIT=20
ONEITB_REGISTRATION_IDENTITY_LIMIT=5
ONEITB_REGISTRATION_WINDOW_MINUTES=60
ONEITB_REGISTRATION_MAX_TRACKED_KEYS=100000
ONEITB_MAGIC_LINK_REQUEST_IP_LIMIT=10
ONEITB_MAGIC_LINK_REQUEST_IDENTITY_LIMIT=3
ONEITB_MAGIC_LINK_REDEMPTION_IP_LIMIT=20
ONEITB_MAGIC_LINK_REDEMPTION_CREDENTIAL_LIMIT=5
ONEITB_MAGIC_LINK_WINDOW_MINUTES=15
ONEITB_MAGIC_LINK_MAX_TRACKED_KEYS=100000

# Trusted Docker network used by Nginx to forward the real client address.
ONEITB_DOCKER_SUBNET=172.30.0.0/24
