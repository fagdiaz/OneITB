# Public Microsoft Entra SPA identifiers. Do not add a client secret.
# Register the local URI exactly under Authentication > Single-page application (SPA).
# Deployed environments must replace it with an HTTPS callback on the deployed origin.
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_API_SCOPE=
VITE_ENTRA_REDIRECT_URI=http://localhost:5173/auth/microsoft/callback
